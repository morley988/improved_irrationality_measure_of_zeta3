import Zeta3.Construction.Asymmetric

/-!
# The effective-pole degree bound for the actual cubic determinant

The useful bound is `deg F_(50n) ≤ 34n+1`, not the coarse matrix-size bound
`51n`.  A monic change of basis puts every column after `34n+1` in the ideal
generated by the remaining-pole polynomial.  Those columns have zero slope.
The determinant expansion then bounds the degree by the number of columns
that may still be affine.

This is an upper bound, which is sufficient for quantitative transfer.  It
does not claim the manuscript's equality of degrees.
-/

noncomputable section
namespace Zeta3.Construction

open Polynomial
open Zeta5.Construction

/-- A consecutive product of positive square-node factors. -/
def nodeTail (m d : ℕ) : ℚ[X] :=
  ∏ a ∈ Finset.range d, (X + C (((m + a : ℕ) : ℚ) ^ 2))

theorem nodeTail_monic (m d : ℕ) : (nodeTail m d).Monic := by
  exact monic_prod_of_monic _ _ (fun a _ => monic_X_add_C _)

theorem nodeTail_natDegree (m d : ℕ) : (nodeTail m d).natDegree = d := by
  rw [nodeTail, natDegree_prod_of_monic]
  · simp only [natDegree_X_add_C, Finset.sum_const, Finset.card_range, smul_eq_mul, mul_one]
  · intro a ha
    exact monic_X_add_C _

theorem nodeTail_eval_neg_square_eq_zero {m d i : ℕ}
    (hmi : m ≤ i) (hid : i < m + d) :
    (nodeTail m d).eval (-((i : ℚ) ^ 2)) = 0 := by
  rw [nodeTail, eval_prod]
  apply Finset.prod_eq_zero (i := i - m) (Finset.mem_range.mpr (by omega))
  rw [Nat.add_sub_of_le hmi]
  simp

def remainingPolePolynomial (n : ℕ) : ℚ[X] := nodeTail (16 * n) (34 * n + 1)

theorem remainingPolePolynomial_monic (n : ℕ) : (remainingPolePolynomial n).Monic :=
  nodeTail_monic _ _

theorem remainingPolePolynomial_natDegree (n : ℕ) :
    (remainingPolePolynomial n).natDegree = 34 * n + 1 := nodeTail_natDegree _ _

theorem weighted_remainingPole_eval_zero (n : ℕ) {i : ℕ} (hi : i < 50 * n) :
    (positiveFactor (4 * n) * positiveFactor (16 * n) * remainingPolePolynomial n).eval
      (pole (i + 1)) = 0 := by
  by_cases hsmall : i + 1 < 16 * n
  · simp only [eval_mul, pole]
    rw [positiveFactor_eval_neg_square_eq_zero hsmall]
    ring
  · have htail : (remainingPolePolynomial n).eval (pole (i + 1)) = 0 := by
      apply nodeTail_eval_neg_square_eq_zero (by omega)
      omega
    simp [eval_mul, htail]

/-- A monic basis adapted to divisibility by a monic polynomial of degree `d`. -/
def adaptedBasis (E : ℚ[X]) (d k : ℕ) : ℚ[X] :=
  if k < d then X ^ k else E * X ^ (k - d)

theorem adaptedBasis_monic {E : ℚ[X]} (hE : E.Monic) (d k : ℕ) :
    (adaptedBasis E d k).Monic := by
  unfold adaptedBasis
  split_ifs
  · exact monic_X_pow k
  · exact hE.mul (monic_X_pow _)

theorem adaptedBasis_natDegree {E : ℚ[X]} (hE : E.Monic) {d : ℕ}
    (hd : E.natDegree = d) (k : ℕ) :
    (adaptedBasis E d k).natDegree = k := by
  unfold adaptedBasis
  split_ifs with hk
  · exact natDegree_X_pow k
  · rw [natDegree_mul hE.ne_zero (pow_ne_zero _ X_ne_zero), hd, natDegree_X_pow]
    omega

theorem monic_coefficientMatrix_det (r : ℕ) (q : Fin r → ℚ[X])
    (hm : ∀ i, (q i).Monic) (hd : ∀ i, (q i).natDegree = i.val) :
    (coefficientMatrix r q).det = 1 := by
  have htri : (coefficientMatrix r q).IsUpperTriangular := by
    intro i j hij
    change C ((q j).coeff i.val) = 0
    rw [coeff_eq_zero_of_natDegree_lt, C_0]
    rw [hd]
    exact hij
  rw [Matrix.det_of_isUpperTriangular htri]
  have hdiag : ∀ i : Fin r, coefficientMatrix r q i i = 1 := by
    intro i
    change C ((q i).coeff i.val) = 1
    rw [← hd i, coeff_natDegree, (hm i).leadingCoeff, C_1]
  simp only [hdiag, Finset.prod_const_one]

theorem monic_gram_det_eq (L : ℚ[X] →ₗ[ℚ] ℚ[X]) (r : ℕ)
    (q : Fin r → ℚ[X]) (hm : ∀ i, (q i).Monic)
    (hd : ∀ i, (q i).natDegree = i.val) :
    Matrix.det (fun i j => L (q i * q j)) = (monomialGram L r).det := by
  rw [polynomialValuedGram_change_of_basis L r q (fun i => by rw [hd]; exact i.isLt),
    Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose,
    monic_coefficientMatrix_det r q hm hd, one_mul, mul_one]

/-- Column degree bounds imply a determinant degree bound. -/
theorem natDegree_det_le_sum_columnBounds {ι : Type*} [DecidableEq ι] [Fintype ι]
    (A : Matrix ι ι ℚ[X]) (b : ι → ℕ)
    (hA : ∀ i j, (A i j).natDegree ≤ b j) :
    A.det.natDegree ≤ ∑ j, b j := by
  rw [Matrix.det_apply]
  refine (natDegree_sum_le _ _).trans ?_
  refine Multiset.max_le_of_forall_le _ _ ?_
  simp only [forall_apply_eq_imp_iff, true_and, Function.comp_apply,
    Multiset.mem_map, exists_imp, Finset.mem_univ_val]
  intro g
  calc
    natDegree (Equiv.Perm.sign g • ∏ i : ι, A (g i) i) ≤
        natDegree (∏ i : ι, A (g i) i) := by
      rcases Int.units_eq_one_or (Equiv.Perm.sign g) with sg | sg
      · rw [sg, one_smul]
      · rw [sg, Units.neg_smul, one_smul, natDegree_neg]
    _ ≤ ∑ i : ι, natDegree (A (g i) i) := natDegree_prod_le _ _
    _ ≤ ∑ i : ι, b i := Finset.sum_le_sum (fun i _ => hA (g i) i)

theorem adapted_hankel_column_constant (n : ℕ) (i j : ℕ) (hj : 34 * n + 1 ≤ j) :
    (hankelFunctional n
      (adaptedBasis (remainingPolePolynomial n) (34 * n + 1) i *
       adaptedBasis (remainingPolePolynomial n) (34 * n + 1) j)).natDegree = 0 := by
  unfold hankelFunctional
  simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply]
  rw [numeratorFunctional_constant_of_vanishing]
  · exact natDegree_C _
  · intro a ha
    have hz := weighted_remainingPole_eval_zero n (Finset.mem_range.mp ha)
    have hje : adaptedBasis (remainingPolePolynomial n) (34 * n + 1) j =
        remainingPolePolynomial n * X ^ (j - (34 * n + 1)) := by
      simp [adaptedBasis, Nat.not_lt.mpr hj]
    rw [hje]
    have hpoly :
        positiveFactor (4 * n) * positiveFactor (16 * n) *
          (adaptedBasis (remainingPolePolynomial n) (34 * n + 1) i *
            (remainingPolePolynomial n * X ^ (j - (34 * n + 1)))) =
        (positiveFactor (4 * n) * positiveFactor (16 * n) * remainingPolePolynomial n) *
          (adaptedBasis (remainingPolePolynomial n) (34 * n + 1) i *
            X ^ (j - (34 * n + 1))) := by ring
    rw [hpoly, eval_mul, hz, zero_mul]

theorem hankelPencil_natDegree_le_effectivePoles (n : ℕ) :
    (hankelPencil n).det.natDegree ≤ 34 * n + 1 := by
  let d := 34 * n + 1
  let q : Fin (51 * n) → ℚ[X] := fun i => adaptedBasis (remainingPolePolynomial n) d i.val
  have hm : ∀ i, (q i).Monic := fun i => adaptedBasis_monic (remainingPolePolynomial_monic n) _ _
  have hd : ∀ i, (q i).natDegree = i.val := fun i =>
    adaptedBasis_natDegree (remainingPolePolynomial_monic n)
      (remainingPolePolynomial_natDegree n) _
  rw [hankelPencil_eq_monomialGram, ← monic_gram_det_eq (hankelFunctional n) (51 * n) q hm hd]
  have hcols : ∀ i j : Fin (51 * n),
      (hankelFunctional n (q i * q j)).natDegree ≤ (if j.val < d then 1 else 0) := by
    intro i j
    split_ifs with hj
    · change (numeratorFunctional (50 * n)
        (positiveFactor (4 * n) * positiveFactor (16 * n) * (q i * q j))).natDegree ≤ 1
      exact numeratorFunctional_natDegree_le_one (50 * n)
        (positiveFactor (4 * n) * positiveFactor (16 * n) * (q i * q j))
    · have he := adapted_hankel_column_constant n i.val j.val (by omega)
      exact he.le
  refine (natDegree_det_le_sum_columnBounds _ _ hcols).trans ?_
  change (∑ j : Fin (51 * n), if j.val < d then 1 else 0) ≤ d
  rw [Fin.sum_univ_eq_sum_range (fun j : ℕ => if j < d then (1 : ℕ) else 0) (51 * n)]
  by_cases hn : n = 0
  · simp [hn, d]
  · have hdr : d ≤ 51 * n := by dsimp [d]; omega
    rw [← Finset.sum_range_add_sum_Ico _ hdr]
    have hfirst : (∑ j ∈ Finset.range d, if j < d then 1 else 0) = d := by
      calc
        _ = ∑ _j ∈ Finset.range d, (1 : ℕ) := by
          apply Finset.sum_congr rfl
          intro j hj
          rw [if_pos (Finset.mem_range.mp hj)]
        _ = d := by simp
    have hsecond : (∑ j ∈ Finset.Ico d (51 * n), if j < d then 1 else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      simp [Nat.not_lt.mpr (Finset.mem_Ico.mp hj).1]
    rw [hfirst, hsecond, add_zero]

theorem windowDeterminant_natDegree_le_effectivePoles (n : ℕ) :
    (windowDeterminant n).natDegree ≤ 34 * n + 1 := by
  rw [concrete_windowDeterminant_change_of_basis,
    natDegree_C_mul (factorialPrefactor_pos _ _ _ _).ne']
  exact hankelPencil_natDegree_le_effectivePoles n

theorem windowIntegerPolynomial_natDegree_le_effectivePoles (n : ℕ) :
    (windowIntegerPolynomial n).natDegree ≤ 34 * n + 1 := by
  rw [windowIntegerPolynomial_natDegree]
  exact windowDeterminant_natDegree_le_effectivePoles n

end Zeta3.Construction
